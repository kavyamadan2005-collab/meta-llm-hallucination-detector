APP_NAME=Meta-LLM Hallucination Detection
ENVIRONMENT=development
DATABASE_PATH=database/app.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8501
LOG_LEVEL=INFO
LLM_PROVIDER=development
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
RETRIEVAL_ENABLED_SOURCES=local,wikipedia,openalex,web_search
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php
WIKIPEDIA_USER_AGENT=Meta-LLM-Hallucination-Detection/0.1 (local development)
WIKIPEDIA_TIMEOUT_SECONDS=10
WIKIPEDIA_TOP_K=5
OPENALEX_API_URL=https://api.openalex.org/works
OPENALEX_API_KEY=
OPENALEX_TIMEOUT_SECONDS=10
OPENALEX_TOP_K=5
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=development
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search
TAVILY_TIMEOUT_SECONDS=10
TAVILY_TOP_K=5
RETRIEVAL_INDEX_PATH=data/index
RETRIEVAL_CHUNK_SIZE=500
RETRIEVAL_CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0
